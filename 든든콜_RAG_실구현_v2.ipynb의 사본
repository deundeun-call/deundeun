통화를 요약하라.\\n{TRANSCRIPT}\",\n","    config=types.GenerateContentConfig(\n","        system_instruction=(\"통화 요약기. facts=확인된 사실, pending=미해결 사항. \"\n","                            \"각 항목은 한 문장. 고객 성격을 추정하지 마라.\"),\n","        temperature=0.2,\n","        response_mime_type=\"application/json\", response_schema=SummaryOut))\n","s = r.parsed\n","\n","# ③층은 LLM을 거치지 않고 지표에서 직접 생성\n","caution = []\n","if METRICS[\"재전화_7일내\"] >= 2: caution.append(f\"🔁 7일 내 {METRICS['재전화_7일내']}회차 접촉\")\n","if METRICS[\"위험표현_건수\"] > 0:  caution.append(f\"⚠ 위험표현 {METRICS['위험표현_건수']}건 탐지\")\n","if METRICS[\"이관_건수\"] > 0:      caution.append(f\"↗ 이관 {METRICS['이관_건수']}회\")\n","if METRICS[\"음향_기준선초과_구간\"] > 0:\n","    caution.append(f\"🔊 음성 기준선 초과 {METRICS['음향_기준선초과_구간']}구간\")\n","if METRICS[\"상담사_버튼\"] > 0:    caution.append(\"🙋 상담사 [지금 힘듦] 표시\")\n","\n","W = 60\n","print(\"═\" * W)\n","print(\"  이전 상담 요약        2026-08-06 14:32 · 고객 A-1043 · 상담원 박○○\")\n","print(\"═\" * W)\n","print(\" ① 사실\")\n","for x in s.facts:   print(f\"     · {x}\")\n","print(\" ② 미해결\")\n","for x in s.pending: print(f\"     · {x}\")\n","print(\" ③ 응대 주의     [지표 로그에서 자동 생성 · AI 미개입]\")\n","for x in caution:   print(f\"     {x}\")\n","print(\"─\" * W)\n","print(\" ※ ③층은 LLM을 거치지 않으므로 환각(지어내기)이 원천적으로 불가능합니다.\")"]},{"cell_type":"code","source":["# ==============================================================\n","#  M1. 개인정보 마스킹 규칙   (새 칸을 만들어 붙여넣으세요)\n","#  앞 칸을 하나도 안 돌려도 됩니다. 설치할 것도 없습니다.\n","#  계약 : mask(text) -> (masked_text, hits)\n","#         hits 는 [(종류, 가려낸_원문), ...]\n","# ==============================================================\n","import re\n","from collections import Counter\n","\n","# ---- 손잡이 세 개. 여기만 바꿔 가며 다시 재면 됩니다 ----\n","KOR_MIN   = 4        # 한글로 적힌 숫자 몇 자 이상을 숫자열로 볼 것인가\n","NUM_MIN   = 6        # 아라비아 숫자 몇 자리 이상 붙어 있으면 가릴 것인가 (0 이면 규칙 끔)\n","MASK_STYLE = \"label\" # \"label\" -> [전화번호]   /   \"star\" -> ******\n","\n","KOR_D = \"공영일이삼사오육륙칠팔구\"\n","# 두 글자 성과 한 글자 성을 나눕니다.\n","# 한 글자 성은 뒤에 정확히 2자가 와야 이름으로 봅니다 (성+1자를 허용하면\n","# \"전화인데\" 를 전(성)+화 로 읽어 이름으로 잘못 잡습니다 — 2026.8.26 실측)\n","SUR2 = \"남궁|황보|제갈|선우|독고|사공\"\n","SUR1 = (\"김|이|박|최|정|강|조|윤|장|임|한|오|서|신|권|황|안|송|류|유|전|홍|고|문|양|손|배|백|\"\n","        \"허|남|심|노|하|곽|성|차|주|우|구|민|나|지|엄|채|원|천|방|공|현|함|변|염|여|추|도|소|\"\n","        \"석|선|설|마|길|위|표|명|기|반|왕|금|옥|육|인|맹|제|모\")\n","STOP = {\"고객\",\"상담\",\"담당\",\"확인\",\"결제\",\"주문\",\"배송\",\"환불\",\"접수\",\"문의\",\"안내\",\"처리\",\n","        \"이용\",\"가입\",\"해지\",\"변경\",\"신청\",\"조회\",\"등록\",\"결과\",\"가능\",\"불가\",\"죄송\",\"감사\",\n","        # 아래는 성씨+2자 모양이라 이름으로 잘못 잡히는 콜센터 빈출어 (2026.8.26 실측으로 추가)\n","        \"위약금\",\"고장이\",\"지연이\",\"이관이\",\"서비스\",\"인터넷\",\"나머지\",\"명의자\",\"신청서\",\"성함이\",\n","        \"방문이\",\"기기가\",\"제품이\",\"반품이\",\"설치가\",\"금액이\",\"원인이\",\"우편물\",\"주소가\",\"소액이\",\n","        \"민원이\",\"하자가\",\"구매가\",\"한도가\",\"장애가\",\"조회가\",\"백화점\",\"배송지\",\"손해가\",\"양식이\",\n","        \"최근에\",\"전화가\",\"전화를\",\"문자가\",\"정지가\",\"마감일\",\"도착지\",\"유선상\",\"임시로\",\"강제로\",\n","        \"차액이\",\"원인은\",\"금액은\",\"제품은\",\"기기는\",\"고장은\",\"지연은\",\"이관은\",\"주소는\",\"오늘은\"}\n","TAIL = r\"(?:입니다|이라고|라고|이고요|이고|인데요|인데|이에요|예요|입니당)\"\n","HON  = r\"(?:\\s*(?:고객님|고객|님|씨))\"\n","\n","# 순서를 바꾸지 마세요.\n","# 주민번호(13자리)를 전화번호(11자리)보다 먼저 잡아야 합니다.\n","# 먼저 전화번호를 잡으면 주민번호 앞 11자리가 전화번호로 잘려 나갑니다.\n","RULES = [\n","    (\"이메일\",       r\"[A-Za-z0-9._%+\\-]+\\s*@\\s*[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,}\"),\n","    (\"주민등록번호\", r\"\\d{6}\\s*[-.\\s]?\\s*[1-4]\\d{6}\"),\n","    (\"카드번호\",     r\"\\d{4}\\s*[-.\\s]\\s*\\d{4}\\s*[-.\\s]\\s*\\d{4}\\s*[-.\\s]\\s*\\d{4}|\\b\\d{16}\\b\"),\n","    (\"전화번호\",     r\"01[016789]\\s*(?:에|[-.\\s])?\\s*\\d{3,4}\\s*(?:에|[-.\\s])?\\s*\\d{4}\"\n","                     r\"|0(?:2|[3-6]\\d)\\s*[-.\\s]\\s*\\d{3,4}\\s*[-.\\s]\\s*\\d{4}\"),\n","    (\"계좌번호\",     r\"\\b\\d{2,8}\\s*[-.]\\s*\\d{2,8}\\s*[-.]\\s*\\d{2,8}\\b\"),\n","    (\"주소\",         r\"[가-힣]+(?:시|도)\\s*[가-힣]+(?:시|군|구)\\s*[가-힣0-9]+(?:로|길|동|읍|면)\\s*\\d+(?:\\s*[-]\\s*\\d+)?\"),\n","]\n","if NUM_MIN:\n","    RULES.append((\"긴숫자\", rf\"\\b\\d{{{NUM_MIN},}}\\b\"))\n","RULES += [\n","    (\"한글숫자\", rf\"(?:[{KOR_D}](?:에\\s*|\\s+)?){{{KOR_MIN},}}\"),\n","    (\"이름\",     rf\"(?<![가-힣])(?:(?:{SUR2})[가-힣]{{1,2}}|(?:{SUR1})[가-힣]{{2}})(?={TAIL}|{HON})\"),\n","]\n","\n","def mask(text):\n","    hits = []\n","    def rep(m, kind):\n","        s = m.group(0)\n","        if kind == \"이름\" and s.strip() in STOP:\n","            return s                       # 흔한 업무 낱말은 이름으로 보지 않는다\n","        hits.append((kind, s))\n","        return f\"[{kind}]\" if MASK_STYLE == \"label\" else \"*\" * max(3, len(s.replace(\" \", \"\")))\n","    out = text\n","    for kind, pat in RULES:\n","        out = re.sub(pat, lambda m, k=kind: rep(m, k), out)\n","    return out, hits\n","\n","def mask_counts(text):\n","    \"\"\"UI 의 '개인정보 n건 가림' 표시에 쓸 (종류, 개수)\"\"\"\n","    _, h = mask(text)\n","    return sorted(Counter(k for k, _ in h).items())\n","\n","print(f\"[준비 완료] 규칙 {len(RULES)}개 · 한글숫자 {KOR_MIN}자 이상 · \"\n","      f\"긴숫자 {NUM_MIN if NUM_MIN else '끔'}자리 이상 · 표기 {MASK_STYLE}\")\n","print(\"  \", mask(\"제 번호는 010-1234-5678 이고 김철수입니다\")[0])"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"bVWk4dZTUzbJ","executionInfo":{"status":"ok","timestamp":1787753535800,"user_tz":-540,"elapsed":57,"user":{"displayName":"낑깡","userId":"05215753437445767806"}},"outputId":"abed6286-03f0-46ee-82a4-31c779e375d5"},"execution_count":27,"outputs":[{"output_type":"stream","name":"stdout","text":["[준비 완료] 규칙 9개 · 한글숫자 4자 이상 · 긴숫자 6자리 이상 · 표기 label\n","   제 번호는 [전화번호] 이고 [이름]입니다\n"]}]},{"cell_type":"code","source":["# ==============================================================\n","#  M2. 마스킹 시험지와 채점   (M1 아래에 새 칸으로 붙여넣으세요)\n","#  A = 반드시 가려야 하는 것   / B = 가리면 안 되는 것\n","#  C = 가려야 할지 팀이 정해야 하는 것 (점수에 넣지 않고 따로 봅니다)\n","# ==============================================================\n","_g = globals()\n","if \"mask\" not in _g:\n","    print(\"[중단] mask 가 없습니다. M1 칸을 먼저 실행하세요.\")\n","    raise SystemExit\n","\n","A = [\n","    # --- 휴대전화 ---\n","  