 c in chunks if kw in c[\"text\"]}\n","\n","GOLD = {kw: gold_pages(kw) for _, kw in QA}\n","\n","tight = [(q, kw) for q, kw in QA if 1 <= len(GOLD[kw]) <= 3]\n","loose = [(q, kw) for q, kw in QA if len(GOLD[kw]) >= 4]\n","none_ = [(q, kw) for q, kw in QA if len(GOLD[kw]) == 0]\n","\n","print(\"=\" * 66)\n","print(\"  0. 문항 분류  (검색을 돌리기 전에 정해집니다)\")\n","print(\"=\" * 66)\n","print(f\"  정밀 문항 (정답 쪽 1~3쪽) : {len(tight)}문항  <- 기준 B 를 적용\")\n","print(f\"  느슨 문항 (정답 쪽 4쪽+)  : {len(loose)}문항  <- 별도 표기\")\n","print(f\"  정답 단어가 조각에 없음   : {len(none_)}문항\")\n","if none_:\n","    for q, kw in none_:\n","        print(f\"      - {kw} : {q}\")\n","\n","# ---- 2) 83문항 다시 검색 (결과를 변수에 저장해 두고 계속 씁니다) ----\n","print(f\"\\n  83문항 검색을 시작합니다. 약 {83*1.1/60:.1f}분 걸립니다.\\n\")\n","\n","R_pos, R_neg = [], []\n","for q, kw in QA:\n","    hits, best = quiet_search(q)\n","    bm = float(max(bm25.get_scores(tok(q))))\n","    R_pos.append({\"q\": q, \"kw\": kw, \"hits\": hits, \"sim\": best, \"bm25\": bm})\n","for q in OFF:\n","    hits, best = quiet_search(q)\n","    bm = float(max(bm25.get_scores(tok(q))))\n","    R_neg.append({\"q\": q, \"kw\": None, \"hits\": hits, \"sim\": best, \"bm25\": bm})\n","\n","# ---- 3) 두 기준으로 채점 ----\n","def hit_word(r, k=3):\n","    return any(r[\"kw\"] in h[\"chunk\"][\"text\"] for h in r[\"hits\"][:k])\n","\n","def hit_page(r, k=3):\n","    g = GOLD[r[\"kw\"]]\n","    return any((h[\"chunk\"][\"doc\"], h[\"chunk\"][\"page\"]) in g for h in r[\"hits\"][:k])\n","\n","A_all = sum(hit_word(r) for r in R_pos)\n","tight_r = [r for r in R_pos if 1 <= len(GOLD[r[\"kw\"]]) <= 3]\n","loose_r = [r for r in R_pos if len(GOLD[r[\"kw\"]]) >= 4]\n","\n","A_tight = sum(hit_word(r) for r in tight_r)\n","B_tight = sum(hit_page(r) for r in tight_r)\n","A_loose = sum(hit_word(r) for r in loose_r)\n","B_loose = sum(hit_page(r) for r in loose_r)\n","B1_tight = sum(hit_page(r, 1) for r in tight_r)\n","\n","print(\"=\" * 66)\n","print(\"  1. 채점 결과\")\n","print(\"=\" * 66)\n","print(f\"