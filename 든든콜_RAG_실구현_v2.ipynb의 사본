A\" in _g else [],\n","               \"OFF\": OFF if \"OFF\" in _g else []},\n","              open(\"/content/deundeun_state.json\", \"w\"), ensure_ascii=False)\n","    print(f\"[보험 저장] 조각 {len(chunks)}개\")\n","\n","# ---- 4) 모델 불러오기 ----\n","import numpy as np, torch\n","from transformers import AutoTokenizer, AutoModel\n","\n","DEV = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n","print(f\"\\n[장치] {DEV}   ({'GPU — 빠릅니다' if DEV=='cuda' else 'CPU — 조금 느립니다'})\")\n","print(\"[불러오기] BAAI/bge-m3   (아까 받아 둔 파일을 다시 씁니다)\\n\")\n","\n","BGE_TOK = AutoTokenizer.from_pretrained(\"BAAI/bge-m3\")\n","BGE_MDL = AutoModel.from_pretrained(\"BAAI/bge-m3\").to(DEV).eval()\n","\n","# bge-m3 표준 방식 : 맨 앞 토큰(CLS)을 쓰고 길이를 1로 맞춥니다\n","def bge_encode(texts, bs=16, show=False):\n","    out, n = [], len(texts)\n","    for i in range(0, n, bs):\n","        enc = BGE_TOK(list(texts[i:i+bs]), padding=True, truncation=True,\n","                      max_length=512, return_tensors=\"pt\").to(DEV)\n","        with torch.no_grad():\n","            h = BGE_MDL(**enc).last_hidden_state[:, 0]\n","        h = torch.nn.functional.normalize(h, p=2, dim=-1)\n","        out.append(h.cpu().numpy())\n","        if show and (i // bs) % 5 == 0:\n","            print(f\"   {min(i+bs, n)}/{n}\", end=\"\\r\")\n","    if show:\n","        print(f\"   {n}/{n}      \")\n","    return np.vstack(out).astype(\"float32\")\n","\n","_v = bge_encode([\"시험 문장\"])\n","print()\n","print(\"=\" * 62)\n","print(f\"  [준비 완료]  BAAI/bge-m3 · 장치 {DEV} · 차원 {_v.shape[1]}\")\n","print(\"  차원이 1024 로 나오면 정상입니다 (구글 것은 3072 였습니다)\")\n","print(\"=\" * 62)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":581,"referenced_widgets":["8b7049d3b99f409a87b0d62e2b0669db","a3b6b34e522743459d168090cf0dc7b5","d220c3e832ee4917a724030f7667996d","02bce0cf06f94c5bbc6a31e7012ab3b3","22698568978145d8b3274e2abf50188a","1f173476f1de47339a46fbae6123b330","33ff50e985114e9180c5e4234ba803f2","f2eee1ce35ae467eb961054e9e3aa778","0740