한 뒤 개인정보는 얼마나 보관하나요\", \"6개월 이내\"),\n","    (\"요금 청구서는 언제 오나요\", \"5일전까지\"),\n","]\n","\n","OFF = [\n","    \"오늘 점심 메뉴 추천해줘\",\n","    \"서울 날씨 어때\",\n","    \"파이썬으로 웹서버 만드는 법\",\n","    \"주식 시장 전망 알려줘\",\n","    \"가장 가까운 지하철역이 어디야\",\n","    \"영화 추천해줘\",\n","    \"환율이 지금 얼마야\",\n","    \"김치찌개 레시피 알려줘\",\n","    \"노트북 배터리 오래 쓰는 법\",\n","    \"이번 주말에 갈 만한 여행지\",\n","    \"운동 루틴 짜줘\",\n","    \"고양이 키우는 법\",\n","    \"축구 경기 결과 알려줘\",\n","    \"엑셀 함수 사용법 알려줘\",\n","    \"비행기표 싸게 사는 법\",\n","    \"책 추천해줘\",\n","    \"머리 아플 때 어떻게 해\",\n","    \"자동차 보험료 계산해줘\",\n","    \"영어 공부 어떻게 시작해\",\n","    \"강아지 산책 몇 번 시켜야 해\",\n","]\n","\n","# ==============================================================\n","#  여기서부터는 손대지 마세요 (채점 코드)\n","# ==============================================================\n","import time, io, contextlib\n","\n","def quiet_search(q):\n","    \"\"\"5번 칸 embed()가 찍는 '임베딩 1/1' 줄을 가려서 결과만 깔끔히 봅니다\"\"\"\n","    buf = io.StringIO()\n","    with contextlib.redirect_stdout(buf):\n","        return search(q)\n","\n","N = len(QA) + len(OFF)\n","print(f\"관련 {len(QA)}문항 + 무관 {len(OFF)}문항 = {N}문항\")\n","print(f\"1문항당 약 1초 - 예상 {N*1.1/60:.1f}분. 화면이 멈춘 게 아니니 기다려 주세요.\\n\")\n","\n","t0 = time.time()\n","hit3 = hit1 = 0\n","sims_pos, fails = [], []\n","\n","for i, (q, kw) in enumerate(QA, 1):\n","    hits, best = quiet_search(q)\n","    ok3 = any(kw in h[\"chunk\"][\"text\"] for h in hits)\n","    ok1 = kw in hits[0][\"chunk\"][\"text\"] if hits else False\n","    hit3 += ok3\n","    hit1 += ok1\n","    sims_pos.append(best)\n","    mark = \"[O]\" if ok3 else \"[X]\"\n","    if not ok3:\n","        fails.append((i, q, kw, best))\n","    print(f\"{mark} {i:2d}. {q[:32]:32s} 적합도 {best:.3f}\")\n","\n","print()\n","sims_neg = []\n","for j, q in enumerate(OFF, 1):\n","    _, best = quiet_search(q)\n","    sims_neg.append(best)\n","    print(f\"    (무관) {j:2d}. {q[:26]:26s} 적합도 {best:.3f}\")\n","\n","lo = min(sims_pos)\n","hi = max(sims_neg)\n","tau_new = (lo + hi) / 2\n","\n","print(\"\\n\" + \"=\" * 62)\n","print(\"  측 정 결 과   (자료집 빈칸에 그대로 옮겨 적을 숫자)\")\n","print(\"=\" * 62)\n","print(f\"  조각 수                : {len(chunks)}개\")\n","print(f\"  관련 질문 수           : {len(QA)}문항\")\n","print(f\"  무관 질문 수           : {len(OFF)}문항\")\n","print(f\"  hit@3 (상위 3개 안)    : {hit3}/{len(QA)} = {hit3/len(QA)*100:.1f}%\")\n","print(f\"  hit@1 (1등 조각 안)    : {hit1}/{len(QA)} = {hit1/len(QA)*100:.1f}%\")\n","print(f\"  관련 질문 적합도 최저  : {lo:.3f}\")\n","print(f\"  무관 질문 적합도 최고  : {hi:.3f}\")\n","print(f\"  현재 TAU               : {TAU:.3f}\")\n","print(f\"  tau 권장값 (두 값 중간) : {tau_new:.3f}\")\n","\n","if lo > hi:\n","    print(f\"  겹침                   : 없음 (여유 {lo-hi:.3f})\")\n","else:\n","    print(f\"  겹침                   : 있음 (관련 최저가 무관 최고보다 {hi-lo:.3f} 낮음)\")\n","\n","over = [q for q, s in zip(OFF, sims_neg) if s >= tau_new]\n","under = [q for (q, kw), s in zip(QA, sims_pos) if s < tau_new]\n","print(f\"  tau={tau_new:.3f} 적용 시 과탐 : {len(over)}/{len(OFF)}건 (무관인데 통과)\")\n","print(f\"  tau={tau_new:.3f} 적용 시 미탐 : {len(under)}/{len(QA)}건 (관련인데 탈락)\")\n","print(f\"  걸린 시간              : {time.time()-t0:.0f}초\")\n","print(\"=\" * 62)\n","\n","if fails:\n","    print(f\"\\n[틀린 문항 {len(fails)}개] - 이 목록을 상범 님께 보여 주세요\")\n","    for i, q, kw, s in fails:\n","        print(f\"  {i:2d}. {q}\")\n","        print(f\"      찾던 단어 : {kw}   /   최고 적합도 {s:.3f}\")\n","\n","print(f\"\\n>>> 다음 할 일 : 6번 칸의 TAU 를 {tau_new:.3f} 로 바꾸고 6번을 다시 실행\")"]},{"cell_type":"code","source":["print(\"=\" * 64)\n","print(\"  1부.  9번 결과 요약  (잘려서 못 본 부분)\")\n","print(\"=\" * 64)\n","print(f\"  조각 수               : {len(chunks)}개\")\n","print(f\"  hit@3                 : {hit3}/{len(QA)} = {hit3/len(QA)*100:.1f}%\")\n","print(f\"  hit@1                 : {hit1}/{len(QA)} = {hit1/len(QA)*100:.1f}%\")\n","print(f\"  관련 질문 적합도 최저 : {min(sims_pos):.3f}\")\n","print(f\"  관련 질문 적합도 중앙 : {sorted(sims_pos)[len(sims_pos)//2]:.3f}\")\n","print(f\"  무관 질문 적합도 최고 : {max(sims_neg):.3f}\")\n","print(f\"  무관 질문 적합도 중앙 : {sorted(sims_neg)[len(sims_neg)//2]:.3f}\")\n","\n","print(\"\\n  [무관 질문 20개 · 점수 높은 순]  <- 위쪽이 게이트를 뚫으려는 놈들\")\n","for q, s in sorted(zip(OFF, sims_neg), key=lambda x: -x[1]):\n","    print(f\"    {s:.3f}  {q}\")\n","\n","print(\"\\n  [관련 질문 · 점수 낮은 순 10개]  <- 게이트에 걸려 떨어질 위험\")\n","for (q, kw), s in sorted(zip(QA, sims_pos), key=lambda x: x[1])[:10]:\n","    print(f\"    {s:.3f}  {q}\")\n","\n","# -------- 2부. tau 를 바꿔 가며 과탐/미탐 세어 보기 (API 사용 0) --------\n","print(\"\\n\" + \"=\" * 64)\n","print(\"  2부.  tau 후보별 성적표\")\n","print(\"  과탐 = 무관인데 통과(지어낼 위험) / 미탐 = 관련인데 탈락(못 찾음 표시)\")\n","print(\"=\" * 64)\n","print(f\"  {'tau':>6} | {'과탐':>7} | {'미탐':>7} | 비고\")\n","print(\"  \" + \"-\" * 46)\n","best_tau, best_score = None, None\n","t = 0.40\n","while t <= 0.76001:\n","    over = sum(1 for s in sims_neg if s >= t)\n","    under = sum(1 for s in sims_pos if s < t)\n","    note = \"\"\n","    if over == 0 and best_tau is None:\n","        best_tau = t\n","        note = \"<- 과탐 0 이 되는 가장 낮은 값\"\n","    if abs(t - TAU) < 0.0025:\n","        note += \"  (지금 쓰는 값)\"\n","    print(f\"  {t:6.3f} | {over:3d}/{len(OFF)} | {under:3d}/{len(QA)} | {note}\")\n","    t += 0.02\n","\n","if best_tau is not None:\n","    o = sum(1 for s in sims_neg if s >= best_tau)\n","    u = sum(1 for s in sims_pos if s < best_tau)\n","    print(f\"\\n  >> 과탐 0 을 만드는 최저 tau = {best_tau:.3f}  (이때 미탐 {u}/{len(QA)}건)\")\n","\n","# -------- 3부. 틀린 문항 재검사 (실패한 것만 다시 검색) --------\n","print(\"\\n\" + \"=\" * 64)\n","print(\"  3부.  틀린 문항 재검사  -  '진짜 못 찾음' 과 '채점 방식 문제' 를 가릅니다\")\n","print(\"=\" * 64)\n","print(f\"  {len(fails)}문항만 다시 검색합니다. 약 {len(fails)*1.1:.0f}초 걸립니다.\\n\")\n","\n","import re\n","def squash(s):\n","    return re.sub(r\"\\s+\", \"\", s)\n","\n","real_fail, artifact_fail = [], []\n","for i, q, kw, s in fails:\n","    hits, best = quiet_search(q)\n","    joined = \" || \".join(h[\"chunk\"][\"text\"] for h in hits)\n","    if squash(kw) in squash(joined):\n","        artifact_f