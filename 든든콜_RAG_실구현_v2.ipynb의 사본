\"Chroma\"\n","except Exception as e:\n","    print(f\"[알림] Chroma 를 못 써서 numpy 로 검색합니다 : {str(e)[:60]}\")\n","\n","print(\"=\" * 62)\n","print(f\"  벡터 저장소 : {BACKEND}\")\n","print(f\"  BM25 색인   : 그대로 (단어 검색은 임베딩과 무관합니다)\")\n","print(\"=\" * 62)\n","print(\"  다음 : 6번 칸을 다시 ▶ 하세요.\")\n","print(\"        그때부터 검색이 bge-m3 로 돕니다.\")\n","print(\"=\" * 62)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"bJYk3IqzqoN7","executionInfo":{"status":"ok","timestamp":1787758573014,"user_tz":-540,"elapsed":813687,"user":{"displayName":"낑깡","userId":"05215753437445767806"}},"outputId":"e31be817-b169-4c14-b3d8-98cdeb2ce43c"},"execution_count":38,"outputs":[{"output_type":"stream","name":"stdout","text":["조각 430개를 숫자로 바꾸는 중... (외부 전송 0건)\n","   430/430      \n","\n","[OK] 벡터 430개 · 차원 1024 · 813초\n","==============================================================\n","  벡터 저장소 : Chroma\n","  BM25 색인   : 그대로 (단어 검색은 임베딩과 무관합니다)\n","==============================================================\n","  다음 : 6번 칸을 다시 ▶ 하세요.\n","        그때부터 검색이 bge-m3 로 돕니다.\n","==============================================================\n"]}]},{"cell_type":"code","source":["# ==============================================================\n","#  7-M4. 보호조치 카드 + 응대 스크립트   [최종판]\n","#  7-M3 아래에 새 칸을 만들어 붙여넣으세요.\n","#\n","#  두 기능을 분리합니다. 지금까지는 섞여 있어서 1단계 자리에\n","#  2단계 문안이 나왔습니다.\n","#\n","#   보호조치 카드 : 단계를 지표가 정하고, 문안은 정부 가이드 원문 그대로\n","#                  언어모델을 한 번도 안 부릅니다\n","#   응대 스크립트 : 고객 발화에 맞는 규정 근거를 검색해 언어모델이 다듬습니다\n","#                  단계와 무관합니다\n","# ==============================================================\n","_g = globals()\n","_need = {\"mask\": \"M1 칸\", \"search\": \"6번 칸\", \"client\": \"2번 칸\"}\n","_miss = [f\"  - {k}  ->  {v} 를 먼저 실행하세요\" for k, v in _need.items() if k not in _g]\n","if _miss:\n","    print(\"[중단]\"); print(\"\\n\".join(_miss)); raise SystemExit\n","\n","from pydantic import BaseModel\n","\n","# ── 정부 가이드 원문. 실제 개발에서는 data/protection_texts.yaml 에서 읽습니다 ──\n","#    출처 : 「감정노동 종사자 건강보호 가이드」 공단 2021.12, 38~39쪽\n","#    🔴 한 글자도 고치지 마세요. 기획서에 \"매뉴얼에 없는 조치를 만들지 않는다\"고 적어 냈습니다.\n","PROTECTION = {\n"," 1: {\"name\": \"1단계: 자제요청 및 즉시경고\",\n","     \"script\": \"고객님, 화가 나셨겠지만 차분히 말씀해 주시겠습니까?\\n\"\n","               \"     고객님의 말씀을 잘 듣고 도움드릴 수 있는 방법을 찾아보겠습니다.\",\n","     \"action\": \"폭언(고성, 욕설, 협박 등)을 중단할 것을 요청하고, 이런 행동은 \"\n","               \"문제해결에 도움이 되지 않음을 알리고 대화를 유도하도록 한다.\"},\n"," 2: {\"name\": \"2단계: 녹음 사전고지 및 법규위반 공지\",\n","     \"script\": \"지금 고객님의 대화 내용은 녹음되고 있음을 알려드립니다.\\n\"\n","               \"     고객님의 이런 말씀과 행동은 상대방에게 모욕감과 공포감을 일으키는 위법행위로서\\n\"\n","               \"     관련 법령(형법 제283조 협박, 제311조 모욕죄)에 저촉될 수 있습니다.\\n\"\n","               \"     자제를 부탁드립니다.\",\n","     \"action\": \"폭언을 지속하면 녹음을 하도록 하고, 법규위반을 공지한다. \"\n","               \"전화를 끊기 어려운 문제고객을 전담하는 전담 관리반을 구성하도록 한다.\"},\n"," 3: {\"name\": \"3단계: 통화종료\",\n","     \"script\": \"고객님, 제가 더 이상 도와드릴 수가 없습니다.\\n\"\n","               \"     통화를 종료하도록 하겠습니다.\",\n","     \"action\": \"폭언 중지를 3회 이상한 경우에도 폭언을 지속할 경우, 응대가 불가능함을 \"\n","               \"설명하고 통화를 종료하도록 한다. 소속 부서장에게 보고한다.\"},\n","}\n","SRC = \"감정노동 종사자 건강보호 가이드 (공단, 2021.12) 38~39쪽\"\n","\n","def decide_stage(m):\n","    \"\"\"규정집이 아니라 이 통화의 지표 로그를 보고 코드가 정합니다\"\"\"\n","    if m[\"이번통화_이전권고단계\"] >= 2 and m[\"위험표현_건수\"] >= 2:\n","        return 3\n","    if m[\"이번통화_이전권고단계\"] >= 1 or m[\"위험표현_건수\"] >= 1:\n","        return 2\n","    return 1\n","\n","class ScriptOut4(BaseModel):     # stage 도 source_refs 도 없습니다\n","    script: str\n","    agent_note: str\n","\n","SYS4 = (\n"," \"너는 콜센터 상담사를 돕는 응대 스크립트 생성기다. \"\n"," \"제공된 [근거] 안의 내용만 사용하고 없는 사실을 지어내지 마라.\\n\"\n"," \"근거에는 두 종류가 섞여 있으니 반드시 구분하라 — \"\n"," \"(가) 상담사가 고객에게 그대로 말하는 「응대 예시문」, (나) 절차 설명.\\n\"\n"," \"script : 고객에게 그대로 읽어줄 문장만 넣는다. 근거의 응대 예시문을 최대한 \"\n"," \"원문 그대로 쓰고, 절차·내부 규정 설명은 절대 넣지 마라.\\n\"\n"," \"agent_note : 상담사가 알아야 할 절차를 한 문장으로.\\n\"\n"," \"단계 이름이나 쪽수는 쓰지 마라. 시스템이 따로 붙인다.\")\n","\n","W = 68\n","\n","def run(raw_text, metrics, tag):\n","    print(\"#\" * W)\n","    print(f\"#  {tag}\")\n","    print(\"#\" * W)\n","\n","    masked, pii = mask(raw_text)\n","    print(\"=\" * W)\n","    print(\"  1. 개인정보 마스킹\")\n","    print(\"=\" * W)\n","    print(f\"  [원문]     {raw_text}\")\n","    print(f\"  [마스킹본] {masked}   <- 이것만 외부로 나갑니다\")\n","    print(f\"  [가린 항목] {len(pii)}건 : \" +\n","          (\", \".join(f\"{k}={v}\" for k, v in pii) if pii else \"없음\"))\n","\n","    # ── 보호조치 카드 : 언어모델을 부르지 않습니다 ──────────────\n","    st = decide_stage(metrics)\n","    p = PROTECTION[st]\n","    print(\"\\n\" + \"=\" * W)\n","    print(\"  2. 보호조치 카드   [지표 -> 단계 -> 매뉴얼 원문 · 언어모델 호출 0회]\")\n","    print(\"=\" * W)\n","    for k, v in metrics.items():\n","        print(f\"     {k} = {v}\")\n","    print(f\"  -> {p['name']}\")\n","    print()\n","    print(\"  고객에게 읽어줄 문안   (정부 가이드 원문 그대로)\")\n","    print(f\"     {p['script']}\")\n","    print()\n","    print(\"  상담사 조치\")\n","    print(f\"     {p['action']}\")\n","    print(f\"  근거 : {SRC}\")\n","\n","    # ── 응대 스크립트 : 검색 + 언어모델 ────────────────────────\n","    hits, best = search(masked)\n","    print(\"\\n\" + \"=\" * W)\n","    print(\"  3. 응대 스크립트   [검색 + 언어모델 · 단계와 무관]\")\n","    print(\"=\" * W)\n","    print(f\"  최고 적합도 {best:.3f}   기준 τ = {TAU}\")\n","    if best < TAU:\n","        print(\"  판정 : 규정 근거 없음 -> 언어모델을 호출하지 않습니다\")\n","        print('  화면 표시 : \"관련 규정을 찾지 못했습니다. 상급자 이관을 권장합니다.\"')\n","        print(\"=\" * W + \"\\n\")\n","        return\n","    ctx = \"\\n\\n\".join(\n","        f\"[근거 {n+1}] ({h['chunk']['doc']} {h['chunk']['page']}쪽)\\n{h['chunk']['text']}\"\n","        for n, h in enumerate(hits))\n","    r = client.models.generate_content(\n","        model=GEN_MODEL,\n","        contents=f\"[근거]\\n{ctx}\\n\\n[고객 발화]\\n{masked}\",\n","        config=types.GenerateContentConfig(\n","            system_instruction=SYS4, temperature=0.2,\n","            response_mime_type=\"application/json\", response_schema=ScriptOut4))\n","    o = r.pa